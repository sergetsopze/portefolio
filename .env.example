# France Travail — https://francetravail.io/
# Crée une application, souscris à « API Offres d'emploi v2 »,
# puis copie l'identifiant client et la clé secrète.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Adzuna (gratuit) — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — agrège Indeed et d'autres boards (gratuit)
# https://jooble.org/api/about
JOOBLE_API_KEY=

# JSearch via RapidAPI — offres LinkedIn / Indeed / Glassdoor
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# La Bonne Alternance — e-mail identifiant l'appelant
# https://labonnealternance.apprentissage.beta.gouv.fr/espace-developpeurs
LBA_CALLER_EMAIL=

# Telegram — offres du jour envoyées comme des messages
# 1. Telegram → @BotFather → /newbot → copier le token
# 2. Écris à ton bot, puis @userinfobot pour ton chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recherche par défaut = profil CV (admin sys/réseaux, alternance M2)
JOBS_KEYWORDS=administrateur systèmes réseaux
JOBS_LOCATION=France


